{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read",
    {
      "identifier": "fs:allow-read",
      "allow": [
        { "path": "$APP/**/comps/*" },
        { "path": "$APP/**/comps/*/*" }
      ]
    }
  ]
}
