{
  "schemaVersion": "1.0",
  "name": "led",
  "label": "LED",
  "fix": {
    "file": "fix.svg"
  },
  "flex": {
    "units": {
      "body": {
        "file": "flex/body.svg"
      }
    }
  },
  "pins": [
    {
      "id": "a",
      "x": 0,
      "y": 20
    },
    {
      "id": "k",
      "x": 60,
      "y": 20
    }
  ],
  "params": [
    {
      "id": "forward_voltage",
      "label": "正向压降 (V)",
      "type": "number",
      "default": 1.8,
      "min": 0.5,
      "max": 3.3
    }
  ],
  "visual": {
    "states": {
      "off": {
        "parts": {
          "body": {
            "opacity": 0.1
          }
        }
      },
      "on": {
        "parts": {
          "body": {
            "opacity": 1,
            "color": "#0d5d16"
          }
        }
      }
    },
    "default_state": "off"
  },
  "model": {
    "func": "diode",
    "paramMap": {
      "Vf": "forward_voltage"
    }
  },
  "state_transition": {
    "type": "binary",
    "condition": "electrical.current > 0.001",
    "true_state": "on",
    "false_state": "off"
  }
}